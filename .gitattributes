# Normalize line endings to LF on commit (cross-platform consistency)
* text=auto eol=lf

# Force binary files to avoid line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary

# SQL files
*.sql text eol=lf

# JavaScript/TypeScript
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# Web
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
