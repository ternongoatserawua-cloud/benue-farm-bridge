# ==============================================================================
# Benue Market - Supabase Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> API
# 3. Copy your Project URL and Project Anon/Public Key
# 4. Copy this file to '.env' and populate your values below
# ==============================================================================

# Client-Side Public Keys (Safe to bundle in frontend via VITE_ prefix)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Server / Administrative Key (Never prefix with VITE_ so it stays excluded from client bundle)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==============================================================================
# Paystack Payment Gateway Configuration
# Obtain your API keys from: https://dashboard.paystack.com/#/settings/developer
# ==============================================================================

# Public Key (Loaded by frontend for Paystack Inline popup)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here

# Secret Key (Backend verification only - NEVER expose on frontend)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here

# Webhook Secret (Optional - for verifying webhook events)
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret_here

